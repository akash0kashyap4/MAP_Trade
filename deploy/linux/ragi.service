[Unit]
Description=Ragi Trading Bot (systemd user service)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Ragi_bot
EnvironmentFile=%h/Ragi_bot/.env
Environment=DEPLOYMENT_TARGET=linux
ExecStart=%h/Ragi_bot/venv/bin/python %h/Ragi_bot/main.py
Restart=always
RestartSec=10
StandardOutput=append:%h/Ragi_bot/logs/ragi.log
StandardError=append:%h/Ragi_bot/logs/ragi.log

[Install]
WantedBy=default.target
