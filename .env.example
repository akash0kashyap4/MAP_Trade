# Ragi Bot — copy this file to .env and fill in your values

# ── Auth (required) ──────────────────────────────────────────────────────────
BOT_USERNAME=Panda001
BOT_PASSWORD=change_me_before_deploy
SESSION_SECRET=

# ── Anthropic / AI Brain ─────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional: override the Claude model used for trade decisions
# CLAUDE_MODEL=claude-sonnet-4-6

# ── Groww API ────────────────────────────────────────────────────────────────
GROWW_API_KEY=
GROWW_SECRET_KEY=

# ── AngelOne SmartAPI (live trading only) ────────────────────────────────────
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ── Telegram alerts (optional) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Database (leave blank for local SQLite) ───────────────────────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_PATH=trading_bot.db
