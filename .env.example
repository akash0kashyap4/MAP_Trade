# Ragi Bot — copy this file to .env and fill in your values

# ── Environment ──────────────────────────────────────────────────────────────
# "development" (default) or "production". In production the app disables
# /docs + /openapi.json and REFUSES TO BOOT on a default/empty BOT_PASSWORD or
# an empty SESSION_SECRET.
ENV=production

# ── Auth (required) ──────────────────────────────────────────────────────────
BOT_USERNAME=Panda001
# Must NOT be the default "ChangeMe123!" when ENV=production (boot will fail).
BOT_PASSWORD=change_me_before_deploy
# Required when ENV=production. Generate: python -c "import secrets;print(secrets.token_hex(32))"
SESSION_SECRET=

# ── AI Brain (provider-abstracted) ───────────────────────────────────────────
# Which runtime powers the AI brain. All access goes through the provider
# abstraction (ai/providers/*); switching is config-only, no code change.
#   claude / anthropic   -> Anthropic API (paid)      [default, best for live]
#   gemini               -> Google Gemini (free tier)
#   claude_code          -> Claude Code CLI (`claude -p`, no API key)
#   copilot / copilot_cli-> GitHub Copilot CLI
#   ollama               -> local Ollama server (fully offline/free)
# Fallback chain: comma-separate providers, tried left-to-right, first success
# wins (e.g. CLI down/not-logged-in -> falls through automatically):
#   AI_PROVIDER=claude_code,copilot,claude
AI_PROVIDER=claude

# Anthropic API (AI_PROVIDER=claude|anthropic)
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6

# Google Gemini — FREE tier (AI_PROVIDER=gemini) — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# Claude Code CLI (AI_PROVIDER=claude_code)
# CLAUDE_CLI_BIN=claude
# GitHub Copilot CLI (AI_PROVIDER=copilot)
# COPILOT_CLI_BIN=copilot
# COPILOT_CLI_ARGS=-p
# Ollama (AI_PROVIDER=ollama)
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Shared runtime tuning (all providers)
# LLM_TIMEOUT_S=45
# LLM_MAX_RETRIES=2
# LLM_RETRY_BACKOFF_S=2
# CLAUDE_MAX_TOKENS=4096

# ── Groww API ────────────────────────────────────────────────────────────────
GROWW_API_KEY=
GROWW_SECRET_KEY=

# ── AngelOne SmartAPI (live trading only) ────────────────────────────────────
ANGEL_API_KEY=
ANGEL_CLIENT_ID=
ANGEL_PASSWORD=
ANGEL_TOTP_SECRET=

# ── Telegram alerts (optional) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Database (leave blank for local SQLite) ───────────────────────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DB_PATH=trading_bot.db
